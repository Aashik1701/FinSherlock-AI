# =============================================================================
# FinSherlock AI — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
wheels/

# Virtual environments
.venv/
venv/
env/
ENV/
.env.bak

# pytest / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.benchmarks/

# mypy / pyright
.mypy_cache/
.pyright/
pyrightconfig.json

# -----------------------------------------------------------------------------
# Secrets and local config
# -----------------------------------------------------------------------------
# Keep .env.example committed — it is the template with no real values.
.env
*.env.local
*.secret

# -----------------------------------------------------------------------------
# Data — raw CSVs can be hundreds of MB; keep them out of git
# -----------------------------------------------------------------------------
backend/data/raw/*.csv
backend/data/raw/*.parquet
backend/data/raw/*.json

# Keep the .gitkeep placeholder so the raw/ directory is tracked
!backend/data/raw/.gitkeep

# DuckDB database file — regenerated by running the loader
backend/data/*.duckdb
backend/data/*.duckdb.wal

# -----------------------------------------------------------------------------
# Frontend (React / Node — for when the frontend is added)
# -----------------------------------------------------------------------------
frontend/node_modules/
frontend/.next/
frontend/dist/
frontend/build/
frontend/.turbo/
frontend/.cache/
*.tsbuildinfo

# -----------------------------------------------------------------------------
# IDEs and editors
# -----------------------------------------------------------------------------
.vscode/settings.json
.vscode/launch.json
.idea/
*.iml
*.suo
*.user
*.sublime-workspace
.DS_Store
Thumbs.db

# Keep shared VSCode extension recommendations if added
!.vscode/extensions.json

# -----------------------------------------------------------------------------
# OS
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V8
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# Logs and temp files
# -----------------------------------------------------------------------------
*.log
*.tmp
*.temp
*.swp
*.swo
*~
.cache/
tmp/
temp/

# -----------------------------------------------------------------------------
# Jupyter notebooks (if used for EDA scratch work)
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
# Ignore local override files but keep the main compose file
docker-compose.override.yml
